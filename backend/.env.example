# Copiar a .env y completar con valores reales. Ver app/core/config.py.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eventos

JWT_SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

COOKIE_DOMAIN=
COOKIE_SECURE=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

ZONA_HORARIA=America/Argentina/Buenos_Aires

# RNF-05.1: politica de uso de Nominatim (1 req/s, User-Agent identificatorio).
# Reemplazar el contacto por un email o URL real del equipo.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=eventos-api/0.1 (contacto: completar)
NOMINATIM_INTERVALO_MINIMO_SEGUNDOS=1.0
NOMINATIM_TIMEOUT_SEGUNDOS=5.0
# Opcional, ej. "ar" para limitar los resultados a Argentina.
NOMINATIM_COUNTRYCODES=

# RNF-01.4: cache local de busquedas de lugares.
GEOCODIFICACION_CACHE_TTL_SEGUNDOS=86400
GEOCODIFICACION_CACHE_MAX_ENTRADAS=1000

# RF-03.8: ubicacion en la que se abre el mapa si el usuario rechaza el
# permiso de geolocalizacion. Lat [-90, 90], lng [-180, 180], zoom [0, 19].
UBICACION_DEFAULT_NOMBRE=Buenos Aires
UBICACION_DEFAULT_LAT=-34.6037
UBICACION_DEFAULT_LNG=-58.3816
UBICACION_DEFAULT_ZOOM=12
